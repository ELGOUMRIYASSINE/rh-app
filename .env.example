# ── Database ──
DATABASE_URL=postgresql://yghr:yghr@localhost:5432/yghr

# ── Auth ──  (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-access-secret-at-least-32-characters
APP_URL=http://localhost:3000

# ── Realtime (Socket.IO) ──
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# shared secret used by web/worker to publish events to the realtime server
REALTIME_INTERNAL_SECRET=change-me-internal-secret

# ── Redis / BullMQ ──
REDIS_URL=redis://localhost:6379

# ── SMTP (Mailpit in dev: http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YGHR <no-reply@yghr.ma>"
SALES_EMAIL=commercial@yghr.ma

# ── File storage: "local" (./.uploads, dev without MinIO) or "s3" (MinIO / any S3) ──
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yghr
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Web Push: optional. Without these, keys are generated automatically on first use and kept in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── ADMS / iClock push (address shown to admins for device setup) ──
ADMS_PUBLIC_HOST=localhost
ADMS_PUBLIC_PORT=3000

# Seed demo data (25 employees, planning, punches, leaves, payroll)
SEED_DEMO=1
# Recreate the demo organisation on the next seed (wipes its data)
SEED_RESET=0

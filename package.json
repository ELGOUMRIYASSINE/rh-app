{
  "name": "yghr",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @yghr/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @yghr/db generate",
    "db:push": "pnpm --filter @yghr/db push",
    "db:migrate": "pnpm --filter @yghr/db migrate",
    "db:seed": "pnpm --filter @yghr/db seed",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate:deploy": "pnpm --filter @yghr/db exec prisma migrate deploy",
    "test:e2e": "pnpm --filter @yghr/web test:e2e",
    "org:create": "pnpm --filter @yghr/db org:create"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "embedded-postgres": "18.6.0-beta.19"
  }
}

// YGHR — Prisma schema (PostgreSQL). Every tenant record carries organizationId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  SUPER_ADMIN
  RH
  CHEF
  SALARIE
}

enum ContractType {
  CDI
  CDD
  INTERIM
  STAGE
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED
}

enum PlanningStatus {
  DRAFT
  PUBLISHED
}

enum AssignmentSource {
  MANUAL
  ROTATION
}

enum Severity {
  BLOCKING
  WARNING
}

enum WorkRuleType {
  MAX_WEEKLY_HOURS
  MAX_SHIFT_HOURS
  MAX_DAILY_HOURS
  MIN_SHIFT_HOURS
  BREAK_REQUIRED_AFTER_HOURS
  MIN_BREAK_MINUTES
  MIN_REST_BETWEEN_SHIFTS_HOURS
  MIN_REST_AFTER_NIGHT_HOURS
  WEEKLY_REST_DAYS
  MAX_CONSECUTIVE_NIGHTS
  MAX_CONSECUTIVE_WORK_DAYS
  FORBID_NIGHT_THEN_MORNING
  OVERTIME_AUTO_DETECT
  OVERTIME_WEEKLY_THRESHOLD_HOURS
  MAX_OVERTIME_MONTHLY_HOURS
  DETECT_ABSENCES
  LATE_TOLERANCE_MINUTES
  EARLY_LEAVE_TOLERANCE_MINUTES
}

enum RotationUnit {
  DAY
  WEEK
}

enum DeviceMode {
  LAN
  ADMS
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum PunchSource {
  DEVICE
  TABLET
  MANUAL
  CORRECTION
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  OFF
  DONE
}

enum CountingMethod {
  OUVRABLES
  OUVRES
}

enum LeaveType {
  PAID_LEAVE
  RTT
  REPOS_COMPENSATEUR
  FAMILY_EVENT
  UNPAID_LEAVE
  SICK_LEAVE
  ACCIDENT_TRAVAIL
  ACCIDENT_TRAJET
  MATERNITY
  PATERNITY
  PAID_TRAINING
  ABSENCE_AUTORISEE
  ABSENCE_NON_AUTORISEE
  MISE_A_PIED_DISCIPLINAIRE
  MISE_A_PIED_CONSERVATOIRE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  VALIDATED
  LOCKED
}

enum PayElementKind {
  PRIME
  TRANSPORT
  ADVANCE
  EXPENSE
  DEDUCTION
}

enum TokenType {
  INVITE
  RESET
}

enum SignatureStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

// ───────────────────────── Platform ─────────────────────────

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  features      String[]
  organizations Organization[]
}

model Organization {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  contactEmail            String?
  accountingEmail         String?
  /// Printed on payslips and documents
  address                 String?
  phone                   String?
  ice                     String?
  cnssEmployerNumber      String?
  logoUrl                 String?
  language                String   @default("fr")
  currency                String   @default("MAD")
  timezone                String   @default("Africa/Casablanca")
  nightStart              String   @default("21:00")
  nightEnd                String   @default("06:00")
  weeklyRestDay           Int?
  useServerTimeForPunches Boolean  @default(false)
  require2FAForAdmins     Boolean  @default(false)
  dailyEmails             Boolean  @default(false)
  persistentSessions      Boolean  @default(true)
  tabletRules             Json?
  planId                  String
  plan                    Plan     @relation(fields: [planId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  memberships        Membership[]
  employees          Employee[]
  services           Service[]
  staffCategories    StaffCategory[]
  shiftTypes         ShiftType[]
  assignments        ShiftAssignment[]
  workRules          WorkRule[]
  coverageRules      CoverageRule[]
  rotations          Rotation[]
  planningExceptions PlanningException[]
  ruleChanges        RuleChangeLog[]
  devices            Device[]
  deviceUserMaps     DeviceUserMap[]
  punches            Punch[]
  attendanceDays     AttendanceDay[]
  leavePolicies      LeavePolicy[]
  leaveRequests      LeaveRequest[]
  publicHolidays     PublicHoliday[]
  payrollPeriods     PayrollPeriod[]
  payElements        PayElement[]
  advanceRequests    AdvanceRequest[]
  expenseReports     ExpenseReport[]
  signatureRequests  SignatureRequest[]
  documents          Document[]
  conversations      Conversation[]
  tablets            Tablet[]
  centres            Centre[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  availabilities     Availability[]
  tokens             AuthToken[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  tokens        AuthToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  messages      Message[]
  participants  ConversationParticipant[]
  pushSubs      PushSubscription[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  employeeId     String?      @unique
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  permissions    Json?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  organizationId   String?
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
}

model AuthToken {
  id             String        @id @default(cuid())
  type           TokenType
  tokenHash      String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

// ───────────────────────── Structure ─────────────────────────

model Centre {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  active         Boolean      @default(true)
  services       Service[]
  employees      Employee[]
  tablets        Tablet[]
  createdAt      DateTime     @default(now())
}

model Service {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean        @default(true)
  centreId       String?
  centre         Centre?        @relation(fields: [centreId], references: [id], onDelete: SetNull)
  employees      Employee[]
  coverageRules  CoverageRule[]
  rotationAssignments RotationAssignment[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
}

model StaffCategory {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  active         Boolean        @default(true)
  employees      Employee[]
  shiftTypes     ShiftType[]
  workRules      WorkRule[]
  coverageRules  CoverageRule[]
  rotationAssignments RotationAssignment[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, code])
}

model Employee {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matricule        String?
  firstName        String
  lastName         String
  email            String
  phone            String?
  position         String?
  serviceId        String?
  service          Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffCategoryId  String?
  staffCategory    StaffCategory?  @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  centreId         String?
  centre           Centre?         @relation(fields: [centreId], references: [id], onDelete: SetNull)
  teamLeadId       String?
  teamLead         Employee?       @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  subordinates     Employee[]      @relation("TeamLead")
  contractType     ContractType?
  contractReason   String?
  weeklyHours      Decimal?        @db.Decimal(5, 2)
  hourlyRate       Decimal?        @db.Decimal(10, 2)
  netHourlyRate    Decimal?        @db.Decimal(10, 2)
  monthlyBase      Decimal?        @db.Decimal(12, 2)
  birthDate        DateTime?       @db.Date
  hireDate         DateTime?       @db.Date
  cnssNumber       String?
  cin              String?
  familyDependents Int             @default(0)
  status           EmployeeStatus  @default(ACTIVE)
  kioskPin         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  membership       Membership?
  assignments      ShiftAssignment[]
  deviceUserMaps   DeviceUserMap[]
  punches          Punch[]
  attendanceDays   AttendanceDay[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  payslips         Payslip[]
  payElements      PayElement[]
  advanceRequests  AdvanceRequest[]
  expenseReports   ExpenseReport[]
  signatureRequests SignatureRequest[]
  documents        Document[]
  availabilities   Availability[]
  rotationAssignments RotationAssignment[]
  planningExceptions PlanningException[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

// ───────────────────────── Planning & rules ─────────────────────────

model ShiftType {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            String
  color           String
  startTime       String
  endTime         String
  breakMinutes    Int            @default(0)
  breakPaid       Boolean        @default(false)
  isNight         Boolean        @default(false)
  staffCategoryId String?
  staffCategory   StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  active          Boolean        @default(true)
  assignments     ShiftAssignment[]
  coverageRules   CoverageRule[]
  createdAt       DateTime       @default(now())

  @@unique([organizationId, code])
}

model ShiftAssignment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  shiftTypeId    String?
  shiftType      ShiftType?       @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)
  customStart    String?
  customEnd      String?
  breakMinutes   Int?
  note           String?
  status         PlanningStatus   @default(DRAFT)
  source         AssignmentSource @default(MANUAL)
  leaveRequestId String?
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, date])
  @@index([employeeId, date])
}

model WorkRule {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffCategoryId  String?
  staffCategory    StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)
  type             WorkRuleType
  value            Decimal?       @db.Decimal(10, 2)
  unit             String
  boolValue        Boolean?
  severity         Severity       @default(WARNING)
  exceptionAllowed Boolean        @default(true)
  active           Boolean        @default(true)
  updatedAt        DateTime       @updatedAt
  updatedById      String?

  @@index([organizationId, type])
}

model CoverageRule {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftTypeId     String
  shiftType       ShiftType      @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffCategoryId String?
  staffCategory   StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)
  min             Int
  max             Int?
  days            Int[]
  severity        Severity       @default(BLOCKING)
  active          Boolean        @default(true)
  label           String?
  createdAt       DateTime       @default(now())
}

model Rotation {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  mode           String               @default("AUTO")
  unit           RotationUnit         @default(WEEK)
  sequence       Json
  workDays       Int[]
  active         Boolean              @default(true)
  assignments    RotationAssignment[]
  createdAt      DateTime             @default(now())
}

model RotationAssignment {
  id              String         @id @default(cuid())
  rotationId      String
  rotation        Rotation       @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  staffCategoryId String?
  staffCategory   StaffCategory? @relation(fields: [staffCategoryId], references: [id], onDelete: Cascade)
  startDate       DateTime       @db.Date
  endDate         DateTime?      @db.Date
}

model PlanningException {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  anomalyKey     String
  anomalyType    String?
  ruleId         String?
  date           DateTime     @db.Date
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  justification  String
  approvedById   String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, anomalyKey])
}

model RuleChangeLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String
  entityId       String
  action         String
  before         Json?
  after          Json?
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Availability {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  available      Boolean
  note           String?

  @@unique([employeeId, date])
}

// ───────────────────────── Devices & attendance ─────────────────────────

model Device {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  mode           DeviceMode      @default(LAN)
  ip             String?
  port           Int             @default(4370)
  commPassword   String?
  serialNumber   String?         @unique
  model          String?
  firmware       String?
  userCount      Int?
  lastSeenAt     DateTime?
  lastSyncAt     DateTime?
  status         DeviceStatus    @default(UNKNOWN)
  punches        Punch[]
  userMaps       DeviceUserMap[]
  createdAt      DateTime        @default(now())
}

model DeviceUserMap {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceUserId   String
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, deviceUserId])
}

model Punch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceUserId   String?
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  timestamp      DateTime
  receivedAt     DateTime     @default(now())
  source         PunchSource  @default(DEVICE)
  verifyMode     String?
  direction      String?
  reason         String?
  deletedAt      DateTime?
  createdById    String?
  rawPayload     Json?

  @@unique([deviceId, deviceUserId, timestamp])
  @@index([organizationId, timestamp])
  @@index([employeeId, timestamp])
}

model AttendanceDay {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  firstIn         DateTime?
  lastOut         DateTime?
  plannedMinutes  Int              @default(0)
  workedMinutes   Int              @default(0)
  normalMinutes   Int              @default(0)
  nightMinutes    Int              @default(0)
  overtimeMinutes Int              @default(0)
  lateMinutes     Int              @default(0)
  earlyLeaveMinutes Int            @default(0)
  status          AttendanceStatus @default(OFF)
  issues          String[]
  justified       Boolean?
  validatedById   String?
  validatedAt     DateTime?
  corrections     Json?
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

// ───────────────────────── Leave ─────────────────────────

model LeavePolicy {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveType             LeaveType
  enabled               Boolean        @default(true)
  countingMethod        CountingMethod @default(OUVRABLES)
  accruedPerMonth       Decimal?       @db.Decimal(5, 2)
  annualAllowance       Decimal?       @db.Decimal(5, 2)
  annualCap             Decimal?       @db.Decimal(5, 2)
  periodStart           String         @default("01-01")
  allowAdvanceFirstYear Boolean        @default(false)

  @@unique([organizationId, leaveType])
}

model LeaveRequest {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  halfDayStart   Boolean         @default(false)
  halfDayEnd     Boolean         @default(false)
  days           Decimal         @db.Decimal(5, 2)
  comment        String?
  attachmentUrl  String?
  status         RequestStatus   @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdById    String
  createdAt      DateTime        @default(now())
  assignments    ShiftAssignment[]

  @@index([organizationId, status])
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType
  periodYear Int
  acquired   Decimal   @default(0) @db.Decimal(6, 2)
  taken      Decimal   @default(0) @db.Decimal(6, 2)
  adjusted   Decimal   @default(0) @db.Decimal(6, 2)

  @@unique([employeeId, leaveType, periodYear])
}

model PublicHoliday {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  name           String

  @@unique([organizationId, date])
}

// ───────────────────────── Payroll ─────────────────────────

model FiscalRuleVersion {
  id        String          @id @default(cuid())
  country   String          @default("MA")
  label     String?
  validFrom DateTime        @db.Date
  validTo   DateTime?       @db.Date
  data      Json
  periods   PayrollPeriod[]
  createdAt DateTime        @default(now())
}

model PayrollPeriod {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month               Int
  year                Int
  currency            String
  fiscalRuleVersionId String
  fiscalRuleVersion   FiscalRuleVersion @relation(fields: [fiscalRuleVersionId], references: [id])
  status              PayrollStatus     @default(DRAFT)
  calculatedAt        DateTime?
  validatedById       String?
  validatedAt         DateTime?
  lockedAt            DateTime?
  payslips            Payslip[]
  elements            PayElement[]
  createdAt           DateTime          @default(now())

  @@unique([organizationId, year, month])
}

model Payslip {
  id              String        @id @default(cuid())
  periodId        String
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours           Json
  lines           Json
  gross           Decimal       @db.Decimal(12, 2)
  cnssEmployee    Decimal       @db.Decimal(12, 2)
  amoEmployee     Decimal       @db.Decimal(12, 2)
  ipeEmployee     Decimal       @db.Decimal(12, 2)
  profExpenses    Decimal       @db.Decimal(12, 2)
  taxableNet      Decimal       @db.Decimal(12, 2)
  irGross         Decimal       @db.Decimal(12, 2)
  familyDeduction Decimal       @db.Decimal(12, 2)
  ir              Decimal       @db.Decimal(12, 2)
  net             Decimal       @db.Decimal(12, 2)
  employerCharges Json
  warnings        String[]
  pdfUrl          String?
  createdAt       DateTime      @default(now())

  @@unique([periodId, employeeId])
}

model PayElement {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodId       String?
  period         PayrollPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kind           PayElementKind
  label          String
  amount         Decimal        @db.Decimal(12, 2)
  taxable        Boolean        @default(true)
  cnssSubject    Boolean        @default(true)
  sourceId       String?
  createdAt      DateTime       @default(now())
}

// ───────────────────────── Premium modules ─────────────────────────

model AdvanceRequest {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  reason         String?
  status         RequestStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime      @default(now())
}

model ExpenseReport {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  category       String
  description    String?
  amount         Decimal       @db.Decimal(12, 2)
  vat            Decimal?      @db.Decimal(12, 2)
  receiptUrl     String?
  status         RequestStatus @default(PENDING)
  reimbursement  String        @default("PAYROLL")
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())
}

model SignatureRequest {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String
  signedFileUrl  String?
  fields         Json?
  status         SignatureStatus @default(SENT)
  otpHash        String?
  signedAt       DateTime?
  signedIp       String?
  trail          Json?
  createdById    String
  createdAt      DateTime        @default(now())
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  category       String
  fileUrl        String
  mimeType       String?
  size           Int?
  uploadedById   String?
  createdAt      DateTime     @default(now())
}

model Conversation {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String?
  isGroup        Boolean                   @default(false)
  participants   ConversationParticipant[]
  messages       Message[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Tablet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  centreId       String?
  centre         Centre?      @relation(fields: [centreId], references: [id], onDelete: SetNull)
  token          String       @unique
  rules          Json?
  active         Boolean      @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
}

// ───────────────────────── System ─────────────────────────

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String?
  details        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

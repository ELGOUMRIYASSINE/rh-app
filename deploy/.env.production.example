# ── Copy to /opt/yghr/.env on the server and fill every value ──
DOMAIN=rh.example.ma
ACME_EMAIL=admin@example.ma

# Secrets: generate each with  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
JWT_SECRET=
REALTIME_INTERNAL_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=yghr-storage
MINIO_ROOT_PASSWORD=

S3_REGION=us-east-1
S3_BUCKET=yghr

# Real SMTP (Brevo, Mailjet, Gmail Workspace, OVH…) — invitations and resets are sent by e-mail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YGHR <no-reply@example.ma>"
SALES_EMAIL=commercial@example.ma

# Optional: Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
